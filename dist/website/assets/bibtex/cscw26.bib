title = {Whose Carbon Is It Anyway? Exploring Household Dynamics in Sustainable Mobility Tracking},
year = {2026},
issue_date = {April 2027},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {11},
number = {2 (CSCW)},
url = {https://doi.org/10.1145/3858359},
doi = {10.1145/3858359},
abstract = {Transport behaviors are a major contributor to carbon emissions, and decisions are often made at the household level around what form of transport to take and when. Technology, primarily eco-feedback interfaces (EFIs) have been suggested to support users in making environmentally friendly choices. However, there is a lack in understanding of how the underlying social dynamics of households influence decisions around sustainable practices, particularly through the lens of mobility. To understand how to design technology to better support households in negotiating around sustainable mobility choices, the research team interviewed 21 participants across nine households, probing them with four low-fidelity mockups representative of EFIs from prior work. We found that the varied mobility-related responsibilities among household members, as well as varying perspectives on the environment, can cause friction in the utility of EFIs in the home. We suggest that designs can account for these factors through acknowledging varied roles and perspectives.},
journal = {PACM Human-Computer Interaction},
month = oct,
articleno = {CSCW009},
numpages = {29},
keywords = {Sustainability, HCI, Transportation, Eco-Feedback Interface}
}